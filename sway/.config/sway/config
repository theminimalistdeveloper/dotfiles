################################################################################
# Sway FX
################################################################################
include /etc/sway/config.d/*

# GENERAL
################################################################################

# Set mod key to be windows
set $mod Mod4
smart_borders on
smart_gaps on
# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod
# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:"Inter" 11

gaps inner 8px
corner_radius 12

# macOS-style soft, diffuse shadows
shadows enable
shadow_blur_radius 40
shadow_color #00000040
shadow_inactive_color #0000003f
shadow_offset 0 8

# Smooth macOS-like window animations
animation_duration_ms 300

# Borderless windows (macOS has no per-window titlebars); focus is shown by the shadow
default_border none

# Dim unfocused windows for a clear focus cue
default_dim_inactive 0.15

# macOS acrylic blur for the quickshell menu bar
layer_effects "quickshell" {
    blur enable;
    blur_ignore_transparent enable;
    shadows enable;
}

# PATH VARIABLES
################################################################################
# Screenshot directory
set $screenshot_dir ~/CloudDrive/Screenshots

# Rclone mount directory
set $rclone_mount_dir ~/CloudDrive

# Shutdown mode
set $mode_system System (l) lock, (e) logout, (r) reboot, (s) shutdown
mode "$mode_system" {
    bindsym l exec swaylock, mode "default"
    bindsym e exec swaymsg exit, mode "default"
    bindsym r exec systemctl -i reboot, mode "default"
    bindsym s exec systemctl -i poweroff, mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# WORKSPACE NAMES
# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# MONITORS
################################################################################
# Set up monitors - laptop monitor (eDP-1) centered below external monitor
# Detect and configure monitors automatically
output * bg ~/Pictures/wallpaper.jpeg fill

# Wait for monitors to be detected
exec sleep 1

output * enable

output DP-1 {
  position 0,0
  res 5120x1440
  scale 1
  adaptive_sync on
}
output DP-5 {
  position 0,0
  res 5120x1440@120hz
  scale 1
  adaptive_sync on
}
output eDP-1 {
  position 2560,1440
  res 2880x1800
  scale 2.0
}

# COMMANDS - AUTO EXECUTE ON START
assign [app_id="com.mitchellh.ghostty"] $ws1
assign [app_id="proton.vpn.app.gtk"] $ws4

# Quickshell launcher: keep it floating (sway centers it) and grab keyboard focus
for_window [title="^Launcher$"] floating enable

exec protonvpn-app
exec_always sh -c "pgrep -x quickshell > /dev/null || quickshell -c topbar"
exec ghostty

# BINDINGS
################################################################################

# FOCUS
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+h focus left

# MOVE FOCUSED WINDOW
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+h move left

# CHANGE CONTAINER LAYOUT
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# CONTAINER
# Focus the parent container
bindsym $mod+a focus parent
# Focus the child container
bindsym $mod+d focus child

# SWITCH TO WORKSPACE
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# MOVE FOCUSED CONTAINER TO WORKSPACE
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# RESIZE
# Enter resize mode
bindsym $mod+r mode "resize"

# Bindings for resize mode
mode "resize" {
  # Same bindings, but for the arrow keys
  bindsym h resize shrink width 10 px or 10 ppt
  bindsym j resize grow height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt
  bindsym l resize grow width 10 px or 10 ppt

  # Back to normal: Enter or Escape or $mod+r
  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}
# MISC
## Action brightness
bindsym --locked XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%

# ## Action volume
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- -l 1.2
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.2

# start a terminal
bindsym $mod+Return exec ghostty
# kill focused window
bindsym $mod+Shift+q kill
# start quickshell launcher (macOS Spotlight-style)
bindsym $mod+space exec "quickshell ipc -c topbar call topbar toggleLauncher"
# split in vertical orientation
bindsym $mod+v split v
# reload the configuration file
bindsym $mod+Shift+r reload
# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle
# toggle tiling / floating
bindsym $mod+Shift+f floating toggle
# take a screenshot
bindsym $mod+Shift+p exec grim $screenshot_dir/$(date +"%d%m%Y%s_grim.png")
# shutdown mode
bindsym $mod+Shift+e mode "$mode_system"

# Restart quickshell
bindsym $mod+Shift+w exec "killall quickshell; quickshell -c topbar &"

# Connect to AirpodsPro
bindsym $mod+Shift+a exec ~/.config/scripts/airpods-toggle.sh

input * {
  tap enabled
}

input type:keyboard {
    xkb_layout us
    xkb_variant intl
    xkb_model pc105
    xkb_options compose:ralt
}

# LID BEHAVIOR
################################################################################
# Turn off laptop monitor and lock screen when lid is closed
set $laptop eDP-1
bindswitch --reload --locked lid:on exec "swaymsg 'output $laptop disable' && swaylock"
bindswitch --reload --locked lid:off exec "swaymsg 'output $laptop enable'"

# Mounts
exec rclone mount ProtonDrive: $rclone_mount_dir --vfs-cache-mode writes --allow-non-empty &
# Pass Wayland environment to systemd user session on launch
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
